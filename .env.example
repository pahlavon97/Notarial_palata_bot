# ==============================================================================
# O'ZBEKISTON RESPUBLIKASI NOTARIAL PALATASI TELEGRAM BOTI
# Production & Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_NAME=notarial-palata-bot
APP_VERSION=1.0.0

# Telegram Bot Configuration
# Bot token obtained from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_EXAMPLE
# Execution Mode: "polling" or "webhook"
TELEGRAM_MODE=polling
# Webhook settings (Used only if TELEGRAM_MODE=webhook)
WEBHOOK_DOMAIN=https://your-domain.railway.app
WEBHOOK_PATH=/webhook/telegram
WEBHOOK_SECRET_TOKEN=super_secret_webhook_token_at_least_32_chars_long

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/notarial_palata_db?schema=public

# Redis Configuration (Optional in development, required for multi-instance production)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=notary_bot:

# Security & Rate Limiting Settings
# Max requests per window per user ID
RATE_LIMIT_USER_MAX=20
RATE_LIMIT_USER_WINDOW_SECONDS=60
# Burst limit (max messages per 5 seconds)
RATE_LIMIT_BURST_MAX=5
RATE_LIMIT_BURST_WINDOW_SECONDS=5

# AI / Search Grounding Configuration (Optional)
# If using an external LLM API for query clarification (e.g. OpenAI or Gemini)
# Leave empty to use strict local deterministic legal retrieval
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_MAX_TOKENS=1000

# Legal Source Verification Settings
LEXUZ_BASE_URL=https://lex.uz
ADVICE_UZ_BASE_URL=https://advice.uz
E_NOTARIUS_BASE_URL=https://e-notarius.uz
EXTERNAL_REQUEST_TIMEOUT_MS=6000
CACHE_TTL_NOTARY_SECONDS=86400
CACHE_TTL_LEGAL_DOC_SECONDS=604800

# Logging & Monitoring
LOG_LEVEL=info
LOG_PRETTY=false
